{
  "name": "karpelevic-paper-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:boundary": "node scripts/generate-boundary-module.mjs",
    "content:boundary:check": "node scripts/generate-boundary-module.mjs --check",
    "content:part-i": "node scripts/generate-part-i-content.mjs",
    "content:part-i:check": "node scripts/generate-part-i-content.mjs --check",
    "content:part-ii": "node scripts/generate-part-ii-content.mjs",
    "content:part-ii:check": "node scripts/generate-part-ii-content.mjs --check",
    "content:part-ii-reader": "node scripts/generate-topics-viii-xi-proofs.mjs",
    "content:part-ii-reader:check": "node scripts/generate-topics-viii-xi-proofs.mjs --check",
    "content:proof": "npm run content:part-i && npm run content:part-ii && npm run content:part-ii-reader",
    "content:proof:check": "npm run content:part-i:check && npm run content:part-ii:check && npm run content:part-ii-reader:check",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run content:boundary:check && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "export:proof-html": "npm run build && node scripts/export-proof-standalone.mjs",
    "export:topic-ix-html": "PROOF_ROUTE=/proof/topic-ix PROOF_HTML_OUTPUT=share/Critical_Invariant_Polygons_Topic_IX.html node scripts/export-proof-standalone.mjs",
    "export:topic-xi-html": "PROOF_ROUTE=/proof/topic-xi PROOF_HTML_OUTPUT=share/Critical_Invariant_Polygons_Topic_XI.html node scripts/export-proof-standalone.mjs",
    "export:topic-xii-html": "npm run build && node scripts/package-topic-xii-review.mjs",
    "export:topics-viii-ix-bundle": "node scripts/package-topics-viii-ix-bundle.mjs",
    "package:topic-ix-review": "npm run build && npm run export:topic-ix-html && npm run export:topics-viii-ix-bundle",
    "package:topic-xii-review": "npm run export:topic-xii-html",
    "package:topics-xiii-xiv-review": "NEXT_PUBLIC_PROOF_TOPIC_MAX=14 NEXT_PUBLIC_PROOF_TOPIC_EXCLUSIONS= npm run build && node scripts/package-topics-xiii-xiv-review.mjs",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/karpelevic NEXT_PUBLIC_PROOF_TOPIC_MAX=14 NEXT_PUBLIC_PROOF_TOPIC_EXCLUSIONS= npm run build && node scripts/export-github-pages.mjs && node scripts/verify-github-pages.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:unit": "node --test tests/*.test.mjs public/code/karpelevic-boundary.test.mjs",
    "test": "npm run build && npm run test:unit",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern pages-out",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build:pages"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260823.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
